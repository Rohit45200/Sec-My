# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Atlas Connection
# Provide your MongoDB Atlas connection string (e.g. mongodb+srv://<user>:<password>@cluster0.mongodb.net/techsym26?retryWrites=true&w=majority)
# If left empty, the server automatically uses an in-memory/embedded persistent datastore for seamless local running.
MONGODB_URI=""

# Admin Security
# Passcode used by symposium staff to view registered participants list & CSV export
ADMIN_PASSCODE="admin123"

# Frontend API URL (leave blank for relative /api requests on same origin)
VITE_API_URL=""

# AI Studio App Hosting URL
APP_URL=""
